---
import { getSeoContent } from "../data/seo-content.js";

const { routePath, isEnglish } = Astro.props;
const content = getSeoContent(routePath, isEnglish);
const sectionId = `guide-${routePath === "/" ? "home" : routePath.split("/").filter(Boolean).join("-")}`;
---

{content && (
  <section class="px-5 py-20 lg:px-8" aria-labelledby={sectionId}>
    <div class="mx-auto max-w-7xl rounded-[2.7rem] border border-[#e5dcc6] bg-[#fffdf8] p-8 shadow-sm lg:p-12">
      <div class="max-w-4xl">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#9b7a2f]">{content.eyebrow}</p>
        <h2 id={sectionId} class="mt-4 text-4xl font-semibold tracking-[-0.04em] text-[#14261c] md:text-5xl">{content.title}</h2>
        <p class="mt-6 text-lg leading-8 text-[#526158]">{content.intro}</p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-3">
        {content.highlights.map(([title, description]) => (
          <article class="rounded-3xl bg-[#f7f3ea] p-6 ring-1 ring-[#e9dfc8]">
            <h3 class="text-xl font-semibold text-[#14261c]">{title}</h3>
            <p class="mt-3 leading-7 text-[#607064]">{description}</p>
          </article>
        ))}
      </div>

      <div class="mt-14 grid gap-8 lg:grid-cols-[0.55fr_1.45fr]">
        <div>
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-[#9b7a2f]">{isEnglish ? "Frequently asked questions" : "Preguntas frecuentes"}</p>
          <h2 class="mt-3 text-3xl font-semibold text-[#14261c]">{isEnglish ? "Before you decide" : "Antes de decidir"}</h2>
        </div>
        <div class="space-y-3">
          {content.faqs.map(([question, answer]) => (
            <details class="group rounded-2xl border border-[#e5dcc6] bg-white p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-5 font-semibold text-[#14261c] marker:content-none">
                <span>{question}</span>
                <span aria-hidden="true" class="text-xl text-[#9b7a2f] transition group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-7 text-[#607064]">{answer}</p>
            </details>
          ))}
        </div>
      </div>

      <p class="mt-10 border-t border-[#e5dcc6] pt-6 text-sm leading-6 text-[#6f7f77]">
        {isEnglish
          ? "General information for educational purposes. It does not replace an individual medical evaluation, diagnosis, or treatment. For an emergency, contact your local emergency services."
          : "Información general con fines educativos. No sustituye una valoración, diagnóstico o tratamiento médico individual. Ante una emergencia, contacta a los servicios de urgencias de tu localidad."}
      </p>
    </div>
  </section>
)}
