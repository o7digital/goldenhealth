    "producto/tratamiento-sindrome-metabolico": "/product/metabolic-syndrome-treatment",
    "producto/tratamiento-detox": "/product/detox-treatment",
    "producto/celulas-madre": "/product/stem-cells",
    "producto/tratamiento-hormonal-hombre": "/product/men-hormonal-treatment",
    "producto/tratamiento-hormonal-mujer": "/product/women-hormonal-treatment",
    "booking-calendar/consulta-online-1": "/booking/online-consultation",
    "booking-calendar/consulta-presencial": "/booking/in-person-consultation",
    "booking-calendar/consultas-en-madrid": "/booking/madrid-consultation",
  };
  const staticRoutes = [
    "",
    "historia",
    "programa-integral",
    "tienda",
    "consultas",
    "noticias",
    "contacto",
    "programa-integral/antroposofia",
    "programa-integral/arte-del-buen-comer-y-buen-beber",
    "programa-integral/menu-golden-health",
    "programa-integral/anti-aging",
    "programa-integral/terapias-biologicas",
    "programa-integral/hidratacion-funcional",
    "programa-integral/ciencia-del-deporte",
    "programa-integral/equilibrio-mente-cuerpo-espiritu",
    "programa-integral/salud-nutricional",
    "producto/tratamientos-biologicos",
    "producto/tratamiento-antioxidante",
    "producto/tratamiento-anti-inflamatorio",
    "producto/tratamiento-sindrome-metabolico",
    "producto/tratamiento-detox",
    "producto/celulas-madre",
    "producto/tratamiento-hormonal-hombre",
    "producto/tratamiento-hormonal-mujer",
    "booking-calendar/consulta-online-1",
    "booking-calendar/consulta-presencial",
    "booking-calendar/consultas-en-madrid",
  ];

  const routes = [
    ...staticRoutes,
  ];

  const localizedRoutes = [
    ...routes,
    "en",
    ...routes
      .map((route) => englishPathByStaticRoute[route])
      .filter(Boolean)
      .map((route) => `en${route}`),
  ];

  return localizedRoutes.map((route) => ({
    params: { slug: route || undefined },
    props: { pathname: route ? `/${route}` : "/" },
  }));
}

const { pathname } = Astro.props;
const isEnglish = pathname === "/en" || pathname.startsWith("/en/");
const language = isEnglish ? "en" : "es-MX";
const rawRoutePath = isEnglish ? pathname.replace(/^\/en(?=\/|$)/, "") || "/" : pathname;
const routePath = isEnglish ? routeByEnglishPath[rawRoutePath] || rawRoutePath : rawRoutePath;
const segments = routePath.split("/").filter(Boolean);
const slug = segments.at(-1);
const programMeta = segments[0] === "programa-integral" && slug ? programPages[slug] : undefined;
const productMeta = segments[0] === "producto" && slug ? products[slug] : undefined;
const consultationMeta = segments[0] === "booking-calendar" && slug ? consultations[slug] : undefined;
const baseMeta = pageMeta[routePath] || programMeta || productMeta || consultationMeta || pageMeta["/"];
const localizedMeta = isEnglish
  ? { ...baseMeta, ...(enOverrides[routePath] || englishMetaByRoute[routePath] || {}) }
  : baseMeta;
const title = localizedMeta.title;
const description = localizedMeta.description;
const imageUrl = new URL(localizedMeta.image || pageMeta["/"].image, siteUrl).toString();
const englishRoutePath = englishPathByRoute[routePath] || routePath;
const canonicalPath = isEnglish ? `/en${routePath === "/" ? "" : englishRoutePath}` : routePath;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const alternateEs = new URL(routePath, siteUrl).toString();
const alternateEn = new URL(`/en${routePath === "/" ? "" : englishRoutePath}`, siteUrl).toString();
const isBookingPage = segments[0] === "booking-calendar";
const robots = isBookingPage ? "noindex, follow" : "index, follow, max-image-preview:large";
const seoContent = getSeoContent(routePath, isEnglish);
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalClinic",
  "@id": `${siteUrl}/#clinic`,
  name: "Golden Health MX",
  alternateName: [
    "Golden Health Mexico",
    "Golden Health Mexico CDMX",
    "Golden Health by Silvia del Moral",
    "Golden Health",
  ],
  url: siteUrl,
  logo: `${siteUrl}/images/source/footer/logo.png`,
  image: imageUrl,
  telephone: "+525554178009",
  email: "silvia.delmoral@goldenhealth.com.mx",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Lago Zúrich 96, Ampliación Granada",
    addressLocality: "Miguel Hidalgo",
    postalCode: "11529",
    addressRegion: "Ciudad de México",
    addressCountry: "MX",
  },
  medicalSpecialty: ["Preventive Medicine", "Regenerative Medicine", "Nutrition"],
  priceRange: "$$",
  areaServed: ["Ciudad de México", "Miguel Hidalgo", "Madrid", "Online"],
  sameAs: [
    "https://www.instagram.com/goldenhealthmx/",
    "https://es-la.facebook.com/goldenhealthmx/",
    "https://mx.linkedin.com/in/silviadelmoral",
    "https://www.youtube.com/user/GoldenHealthSalud",
  ],
};
const breadcrumbItems = [
  { name: isEnglish ? "Home" : "Inicio", item: new URL(isEnglish ? "/en" : "/", siteUrl).toString() },
  ...segments.map((segment, index) => {
    const path = `/${segments.slice(0, index + 1).join("/")}`;
    const itemPath = isEnglish ? `/en${englishPathByRoute[path] || path}` : path;
    return {
      name: segment.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase()),
      item: new URL(itemPath, siteUrl).toString(),
    };
  }),
];
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: item.item,
  })),
};
const productJsonLd = productMeta ? {
  "@context": "https://schema.org",
  "@type": "Product",
  name: productMeta.name,
  description: productMeta.description,
  image: new URL(productMeta.image, siteUrl).toString(),
  brand: { "@type": "Brand", name: "Golden Health MX" },
  offers: {
    "@type": "Offer",
    priceCurrency: "MXN",
    price: productMeta.price,
    url: canonicalUrl,
  },
} : undefined;
const physicianJsonLd = routePath === "/historia" ? {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: "Dra. Silvia del Moral",
  image: `${siteUrl}/images/source/history/dra-silvia.webp`,
  worksFor: { "@id": `${siteUrl}/#clinic` },
  jobTitle: isEnglish ? "Founder and medical director" : "Fundadora y médico responsable",
  alumniOf: ["Instituto Nacional de Pediatría", "Goetheanum, Dornach"],
  medicalSpecialty: ["Preventive Medicine", "Regenerative Medicine"],
} : undefined;
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: "Golden Health MX",
  inLanguage: ["es-MX", "en"],
  publisher: { "@id": `${siteUrl}/#clinic` },
};
const webPageJsonLd = {
  "@context": "https://schema.org",
  "@type": routePath === "/historia" ? "ProfilePage" : productMeta ? "ItemPage" : "WebPage",
  "@id": `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: language,
  isPartOf: { "@id": `${siteUrl}/#website` },
  about: { "@id": `${siteUrl}/#clinic` },
};
const faqJsonLd = seoContent?.faqs?.length ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: seoContent.faqs.map(([question, answer]) => ({
    "@type": "Question",
    name: question,
    acceptedAnswer: { "@type": "Answer", text: answer },
  })),
} : undefined;
const jsonLd = [websiteJsonLd, organizationJsonLd, webPageJsonLd, breadcrumbJsonLd, productJsonLd, physicianJsonLd, faqJsonLd].filter(Boolean);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Golden Health MX" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang="es-MX" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />
    <meta property="og:type" content={productMeta ? "product" : "website"} />
    <meta property="og:site_name" content="Golden Health MX" />
    <meta property="og:locale" content={isEnglish ? "en_US" : "es_MX"} />
    <meta property="og:locale:alternate" content={isEnglish ? "es_MX" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-1VCP19Z5NG"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-1VCP19Z5NG');
    </script>
  </head>
  <body>
    <GoldenHealth initialPath={pathname}>
      <SeoContent routePath={routePath} isEnglish={isEnglish} />
    </GoldenHealth>
    <OliviaChat client:idle={{ timeout: 1500 }} />
    <script>
      const menuToggle = document.querySelector("[data-gh-menu-toggle]");
      const mobileMenu = document.querySelector("[data-gh-mobile-menu]");

      const setMenuOpen = (open) => {
        if (!(menuToggle instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
        menuToggle.setAttribute("aria-expanded", String(open));
        menuToggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
        mobileMenu.classList.toggle("hidden", !open);
        mobileMenu.classList.toggle("block", open);
        menuToggle.querySelector('[data-gh-menu-line="top"]')?.classList.toggle("translate-y-2", open);
        menuToggle.querySelector('[data-gh-menu-line="top"]')?.classList.toggle("rotate-45", open);
        menuToggle.querySelector('[data-gh-menu-line="middle"]')?.classList.toggle("opacity-0", open);
        menuToggle.querySelector('[data-gh-menu-line="bottom"]')?.classList.toggle("-translate-y-2", open);
        menuToggle.querySelector('[data-gh-menu-line="bottom"]')?.classList.toggle("-rotate-45", open);
      };

      menuToggle?.addEventListener("click", () => {
        setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") setMenuOpen(false);
      });

      document.querySelectorAll("[data-gh-slider]").forEach((slider) => {
        const slides = Array.from(slider.querySelectorAll("[data-gh-slide]"));
        const buttons = Array.from(slider.querySelectorAll("[data-gh-slide-button]"));
        let activeIndex = 0;

        const showSlide = (index) => {
          activeIndex = index;
          slides.forEach((slide, slideIndex) => {
            slide.classList.toggle("opacity-100", slideIndex === activeIndex);
            slide.classList.toggle("opacity-0", slideIndex !== activeIndex);
          });
          buttons.forEach((button, buttonIndex) => {
            const active = buttonIndex === activeIndex;
            button.classList.toggle("w-12", active);
            button.classList.toggle("bg-[#d3aa45]", active);
            button.classList.toggle("w-6", !active);
            button.classList.toggle("bg-white/35", !active);
          });
        };

        buttons.forEach((button, index) => button.addEventListener("click", () => showSlide(index)));
        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches && slides.length > 1) {
          window.setInterval(() => showSlide((activeIndex + 1) % slides.length), 4000);
        }
      });
    </script>
  </body>
</html>
